[configuration]
entry_symbol = "aerosim_native_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libaerosim_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libaerosim_native.linux.template_release.x86_64.so"
windows.release.x86_64 = "res://bin/libaerosim_native.windows.template_release.x86_64.dll"

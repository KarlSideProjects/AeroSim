{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AeroSim Ubuntu diagnostic support bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build", "platform", "gpu", "controller", "license", "last_error_code", "events", "raw_samples"],
  "properties": {
    "schema_version": {"const": 1},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["hash", "app_version"],
      "properties": {"hash": {"type": "string", "minLength": 1}, "app_version": {"type": "string", "minLength": 1}}
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["distribution", "version"],
      "properties": {"distribution": {"const": "Ubuntu"}, "version": {"type": "string", "minLength": 1}}
    },
    "gpu": {
      "type": "object", "additionalProperties": false,
      "required": ["vendor", "name", "api"],
      "properties": {"vendor": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "api": {"type": "string", "minLength": 1}}
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["connected", "known", "confirmed", "usb_vendor_id", "usb_product_id", "mapping"],
      "properties": {
        "connected": {"type": "boolean"}, "known": {"type": "boolean"}, "confirmed": {"type": "boolean"},
        "usb_vendor_id": {"type": ["integer", "null"]}, "usb_product_id": {"type": ["integer", "null"]},
        "mapping": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "axis_roles", "button_roles", "reversed", "deadzone"],
          "properties": {
            "schema_version": {"const": 1},
            "axis_roles": {"$ref": "#/$defs/axis_roles"},
            "button_roles": {"type": "object", "additionalProperties": false, "required": ["arm", "mode"], "properties": {"arm": {"type": "integer"}, "mode": {"type": "integer"}}},
            "reversed": {"type": "object", "additionalProperties": false, "required": ["roll", "pitch", "yaw", "throttle"], "properties": {"roll": {"type": "boolean"}, "pitch": {"type": "boolean"}, "yaw": {"type": "boolean"}, "throttle": {"type": "boolean"}}},
            "deadzone": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "remaining_seconds"],
      "properties": {
        "state": {"enum": ["not_activated", "online_valid", "offline_grace_valid", "offline_grace_expired", "invalid_token", "revoked"]},
        "remaining_seconds": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "last_error_code": {"type": "string", "pattern": "^(|[a-z][a-z0-9_]{0,63})$"},
    "events": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["time_seconds", "code"], "properties": {"time_seconds": {"type": "number", "minimum": -600, "maximum": 0}, "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}}},
    "raw_samples": {"type": "array", "maxItems": 150, "items": {"type": "object", "additionalProperties": false, "required": ["time_seconds", "roll", "pitch", "yaw", "throttle", "arm", "mode"], "properties": {"time_seconds": {"type": "number", "minimum": -5, "maximum": 0}, "roll": {"type": "number"}, "pitch": {"type": "number"}, "yaw": {"type": "number"}, "throttle": {"type": "number"}, "arm": {"type": "boolean"}, "mode": {"type": "boolean"}}}}
  },
  "$defs": {
    "axis_roles": {"type": "object", "additionalProperties": false, "required": ["roll", "pitch", "yaw", "throttle"], "properties": {"roll": {"type": "integer"}, "pitch": {"type": "integer"}, "yaw": {"type": "integer"}, "throttle": {"type": "integer"}}}
  }
}
